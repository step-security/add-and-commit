{
  "name": "add-and-commit",
  "version": "11.1.1",
  "private": true,
  "description": "Add & commit files from a path directly from GitHub Actions",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/main.ts --minify --out dist",
    "lint": "gts lint",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest && npm run lint",
    "clean": "gts clean",
    "fix": "gts fix"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "axios": "^1.20.0",
    "js-yaml": "^5.3.0",
    "simple-git": "^3.36.0",
    "string-argv": "^0.3.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "24.12.0",
    "@vercel/ncc": "^0.45.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "gts": "^6.0.2",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/step-security/add-and-commit.git"
  },
  "keywords": [
    "github",
    "action",
    "version",
    "npm",
    "node"
  ],
